# Copy to .env and uncomment what you need. Everything here is optional —
# an unset line just falls back to the server's built-in default (shown
# below). A real environment variable (shell export, systemd, docker -e...)
# always beats .env, and a command-line flag beats both, e.g.
# `./imposter -addr :9000`.

# Port the server listens on. Default: 8080
# IMPOSTER_PORT=8080

# Public address players and the QR code should point to. Set this if the
# game's behind a domain (a reverse proxy, a tunnel) instead of being joined
# over the LAN by IP. A bare domain gets https:// added for you.
# Default: the machine's LAN IP
# IMPOSTER_DOMAIN=party.example.com

# Path to the topic list - a JSON array of {"c","w","h"} objects (category,
# word, hint — see topics.json.example). Category isn't used by the game yet.
# Default: topics.json
# IMPOSTER_TOPICS=topics.json

# How long a disconnected player (or the host screen) keeps their seat
# before the room gives it up. Go duration syntax: 90s, 5m, 2m30s.
# Default: 90s
# IMPOSTER_GRACE=90s

# Fewest / most connected players a room will allow.
# Defaults: 2 and 16
# IMPOSTER_MIN_PLAYERS=2
# IMPOSTER_MAX_PLAYERS=16

# Path to the host accounts file (email + bcrypt hash per host login — see
# "Who can run the shared screen" in the README). Gets created on first
# sign-up if it doesn't exist yet.
# Default: accounts.json
# IMPOSTER_ACCOUNTS=accounts.json

# Trust the X-Forwarded-For header for rate limiting instead of the raw TCP
# connection. Only turn this on when something in front of this server
# (Cloudflare, cloudflared, nginx, Caddy) actually sets that header itself -
# with nothing in front of it, a client could write any value they want and
# walk straight through the rate limits.
# Default: false
# IMPOSTER_TRUST_PROXY=false
